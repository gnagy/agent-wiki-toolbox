#!/usr/bin/env bash
# The plugin's own `awt`. Three sources, in order, so the packaging step can be
# switched on and off independently of everything else the plugin does:
#
#   1. ${CLAUDE_PLUGIN_DATA}/lib  a real plugin install, what ships eventually
#   2. ~/.local/lib/...           whatever `bin/install` put there, the default
#                                 for the trial: same code both sides, so a
#                                 difference in behaviour is the plugin form
#   3. the working copy           only when it has node_modules
#
# AWT_SHIM_DEBUG=1 prints the source it chose to stderr. During a trial where
# both the old install and the plugin are live, that line is the only way to
# know which one answered.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA="${CLAUDE_PLUGIN_DATA:-}/lib/packages/cli/bin/awt.mjs"
INSTALLED="$HOME/.local/lib/agent-wiki-toolbox/packages/cli/bin/awt.mjs"
WORKING="$ROOT/packages/cli/bin/awt.mjs"

say() { [[ "${AWT_SHIM_DEBUG:-}" == "1" ]] && printf 'awt: plugin shim -> %s\n' "$1" >&2; return 0; }

if [[ -n "${CLAUDE_PLUGIN_DATA:-}" && -f "$DATA" ]]; then
  say "$DATA"; exec "$DATA" "$@"
elif [[ -f "$INSTALLED" ]]; then
  say "$INSTALLED"; exec "$INSTALLED" "$@"
elif [[ -f "$WORKING" && -d "$ROOT/node_modules" ]]; then
  say "$WORKING"; exec "$WORKING" "$@"
fi

echo "awt: no plugin install, no ~/.local install, no usable working copy at $ROOT" >&2
exit 127
