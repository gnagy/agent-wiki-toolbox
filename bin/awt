#!/usr/bin/env bash
# The plugin's own `awt`.
#
# Dependencies install in place on first use, the way the official plugins that
# ship a node server do (`bun install && bun server.ts` as their start script).
# There is no separate install step and no plugin data directory: the plugin
# directory is writable and 247 MB of node_modules belongs in it.
#
# The lockfile picks the package manager, so switching the repo to bun or pnpm
# needs no change here. A missing manager is an error rather than a fall back to
# npm: the lockfile is the version guarantee, and a formatter that has to stay
# byte-identical to IntelliJ cannot quietly resolve a different remark.
#
# Two things that pattern does not have to worry about and this does:
#
#   cwd     awt resolves the wiki by walking up from where it runs, so the
#           install happens in a subshell and the exec keeps the caller's
#           directory. `npm --cwd`/`--prefix` would move the server into the
#           plugin root, where it would find no project.
#   stdout  an MCP server speaks on stdout, so install chatter has to go to
#           stderr or it corrupts the handshake.
#
# AWT_SHIM_PREFER_INSTALL=1 runs ~/.local/lib instead, for an A/B against the
# machine's copy. AWT_SHIM_DEBUG=1 prints which one answered.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OWN="$ROOT/packages/cli/bin/awt.mjs"
INSTALLED="$HOME/.local/lib/agent-wiki-toolbox/packages/cli/bin/awt.mjs"

say() { [[ "${AWT_SHIM_DEBUG:-}" == "1" ]] && printf 'awt: plugin shim -> %s\n' "$1" >&2; return 0; }

if [[ "${AWT_SHIM_PREFER_INSTALL:-}" == "1" && -f "$INSTALLED" ]]; then
  say "$INSTALLED"; exec "$INSTALLED" "$@"
fi

ensure_deps() {
  local pm; local -a args
  if [[ -f "$ROOT/bun.lock" || -f "$ROOT/bun.lockb" ]]; then
    pm=bun;  args=(install --production --silent)
  elif [[ -f "$ROOT/pnpm-lock.yaml" ]]; then
    pm=pnpm; args=(install -r --prod --silent)
  else
    pm=npm;  args=(install --omit=dev --silent --no-audit --no-fund)
  fi
  say "deps via $pm"
  [[ -d "$ROOT/node_modules" ]] && return 0
  command -v "$pm" >/dev/null 2>&1 || {
    echo "awt: $ROOT has a $pm lockfile but no $pm on PATH" >&2; return 1; }
  ( cd "$ROOT" && "$pm" "${args[@]}" ) 1>&2
}

if [[ -f "$OWN" ]]; then
  ensure_deps || exit 1
  say "$OWN"; exec "$OWN" "$@"
elif [[ -f "$INSTALLED" ]]; then
  say "$INSTALLED"; exec "$INSTALLED" "$@"
fi

echo "awt: no cli in $ROOT and no install at $INSTALLED" >&2
exit 127
