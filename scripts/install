#!/usr/bin/env bash
# Install this working copy onto the machine as a Claude Code plugin.
#
# One target, not two. The plugin directory is the machine's copy of the
# toolbox: Claude Code loads the skill, the hooks and the MCP server from it,
# and ~/.local/bin/awt points into the same tree so a terminal, a build or any
# other agent runs exactly what a session runs. Nothing can drift, because
# there is nothing to drift from.
#
#   working copy  ──install──▶  ~/.claude/skills/awt  ──▶  sessions, shells, builds
#
# Editing the working copy affects nothing until this runs. Pushing to GitHub is
# a separate act, for backup. There is no marketplace entry: plugin.json stays at
# 0.0.0, and a marketplace that pins a version would never see a new snapshot.
#
# Usage:  scripts/install            # install (or reinstall) onto this machine
#         scripts/install --dry-run  # show what would happen
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN="$HOME/.claude/skills/awt"
BIN="$HOME/.local/bin"

DRY=""
[[ "${1:-}" == "--dry-run" ]] && DRY="1"

say() { printf '%s\n' "$*"; }
do_() { if [[ -n "$DRY" ]]; then say "  would: $*"; else "$@"; fi; }

# Running the copy inside the install would make SRC and PLUGIN the same
# directory, and the rm below would delete its own source.
if [[ "$SRC" == "$PLUGIN" ]]; then
  say "refusing to install $PLUGIN onto itself."
  say "Run scripts/install from the working copy, not from the installed copy."
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  say "bun is not on PATH, and this toolbox installs and runs with it."
  say "Install it (mise.toml pins the version) and run this again."
  exit 1
fi

if [[ -n "$(git -C "$SRC" status --porcelain 2>/dev/null)" ]]; then
  say "note: the working copy has uncommitted changes; they will be installed."
  say "      Commit first if you want the installed copy to match a commit."
fi

say "installing $SRC"
say "       -> $PLUGIN"

do_ mkdir -p "$BIN" "$(dirname "$PLUGIN")"

# Replace wholesale rather than merging, so a deleted file cannot survive an
# install and keep being loaded.
if [[ -z "$DRY" ]]; then
  rm -rf "$PLUGIN"
  mkdir -p "$PLUGIN"
  # Everything git tracks plus everything it would track -- the working copy as
  # it stands, minus what .gitignore excludes. `git archive HEAD` was the first
  # try and it silently shipped nothing new: a brand-new directory is untracked,
  # so the whole Quartz plugin was missing from the install while every test in
  # the repo passed.
  git -C "$SRC" ls-files --cached --others --exclude-standard -z |
    tar -C "$SRC" --null -T - -cf - | tar -C "$PLUGIN" -xf -
  ( cd "$PLUGIN" && bun install --production --silent )
else
  say "  would: replace $PLUGIN with the working tree (git ls-files -co), then bun install --production"
fi

do_ ln -sfn "$PLUGIN/bin/awt" "$BIN/awt"
say "  $BIN/awt -> $PLUGIN/bin/awt"

if [[ -z "$DRY" ]]; then
  stamp="$(git -C "$SRC" describe --always --dirty 2>/dev/null || echo unknown)"
  printf '%s\n' "$stamp" > "$PLUGIN/INSTALLED_FROM"
  say ""
  say "installed $stamp"
  say ""
  say "Claude Code adopts $PLUGIN as the plugin 'awt' from the next session:"
  say "the skill is /awt:wiki-docs, and the MCP server and hooks come with it."
  say ""
  say "The Quartz plugin lives at $PLUGIN/quartz-plugins/awt. Every site names it"
  say "by that path in the config awt derives before each build, so the next"
  say "'awt site serve' in any project builds with this install. A project still"
  say "tracking site/quartz.config.yaml with ../awt-* entries: 'awt site migrate'."
  case ":$PATH:" in
    *":$BIN:"*) ;;
    *) say ""; say "WARNING: $BIN is not on PATH." ;;
  esac
fi
